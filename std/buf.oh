// buf: fixed-capacity byte buffer / string builder on a heap (needs std/mem +
// std/core). Capacity chosen at creation; append aborts (137) on overflow rather
// than growing. Struct-typed `data` field removes the per-access cast.
$Buf{data:*1 len:3 cap:3}
#buf_new(b:*Buf,h:*6,cap):v{
b.data=(*1)halloc(h,(6)cap)
b.len=0
b.cap=cap}
#buf_byte(b:*Buf,c):v{
?b.len>=b.cap{sys(60,137)}
d:=b.data
d[b.len]=(1)c
b.len=b.len+1}
#buf_str(b:*Buf,s:c):v{
i:=0
~s[i]!=0{
buf_byte(b,(3)s[i])
i=i+1}}
// format n directly into the buffer: one bounds check, then write digits
// in place (no temp array, no per-byte call) — the hot path for serialization.
#buf_int(b:*Buf,n):v{
?n<0{
buf_byte(b,45)
n=0-n}
?n==0{
buf_byte(b,48)
\}
t:=n
c:=0
~t>0{c=c+1 t=t/10}
?b.len+c>b.cap{sys(60,137)}
d:=b.data
e:=b.len+c
i:=e
~n>0{
i=i-1
d[i]=(1)(48+n%10)
n=n/10}
b.len=e}
#buf_ptr(b:*Buf):6 (6)b.data
#buf_len(b:*Buf)b.len
