// buf: growable byte buffer / string builder on a heap (needs std/mem + std/core).
#buf_new(b:*6,h:*6,cap):v{
b[0]=halloc(h,cap)
b[1]=0
b[2]=cap}
#buf_byte(b:*6,h:*6,c):v{
?b[1]>=b[2]{
nc:=b[2]*2
b[0]=hrealloc(h,b[0],b[2],nc)
b[2]=nc}
d:=(*1)b[0]
li:=(3)b[1]
d[li]=(1)c
b[1]=b[1]+1}
#buf_str(b:*6,h:*6,s:c):v{
i:=0
~s[i]!=0{
buf_byte(b,h,(3)s[i])
i=i+1}}
#buf_int(b:*6,h:*6,n):v{
?n<0{
buf_byte(b,h,45)
n=0-n}
tmp:[16]1
e:=itoa(tmp,0,n)
@i,e{buf_byte(b,h,(3)tmp[i])}}
#buf_ptr(b:*6):6 b[0]
#buf_len(b:*6)(3)b[1]
