o[0]=(6)0x0001 o[1]=(6)0x0000 o[2]=(6)0x0000 o[3]=(6)0x0000 o[4]=(6)0x0000 o[5]=(6)0x0000 o[6]=(6)0xffff o[7]=(6)0xffff
o[8]=(6)0xffff o[9]=(6)0xffff o[10]=(6)0xffff o[11]=(6)0xffff o[12]=(6)0xfffe o[13]=(6)0xffff o[14]=(6)0x0000 o[15]=(6)0x0000
}
