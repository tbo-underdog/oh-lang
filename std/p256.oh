// P-256 (secp256r1) ECDHE. Montgomery field (16x16-bit limbs, m0inv=1),
// Jacobian points. Needs std/core. Verified vs a big-int reference + openssl ECDH.
#p256_p(o:*6):v{
o[0]=(6)0xffff o[1]=(6)0xffff o[2]=(6)0xffff o[3]=(6)0xffff o[4]=(6)0xffff o[5]=(6)0xffff o[6]=(6)0x0000 o[7]=(6)0x0000
o[8]=(6)0x0000 o[9]=(6)0x0000 o[10]=(6)0x0000 o[11]=(6)0x0000 o[12]=(6)0x0001 o[13]=(6)0x0000 o[14]=(6)0xffff o[15]=(6)0xffff
}
