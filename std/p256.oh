o[8]=(6)0x2510 o[9]=(6)0x7762 o[10]=(6)0x732b o[11]=(6)0x79fb o[12]=(6)0x55c6 o[13]=(6)0xa537 o[14]=(6)0x5f76 o[15]=(6)0x1890
}
#p256_gym(o:*6):v{
o[0]=(6)0x560a o[1]=(6)0xce95 o[2]=(6)0x5357 o[3]=(6)0xddf2 o[4]=(6)0xe45c o[5]=(6)0xba19 o[6]=(6)0xb8e4 o[7]=(6)0x8b4a
o[8]=(6)0xf325 o[9]=(6)0xdd21 o[10]=(6)0x8688 o[11]=(6)0xd2e8 o[12]=(6)0x5d85 o[13]=(6)0x2588 o[14]=(6)0xff18 o[15]=(6)0x8571
}
