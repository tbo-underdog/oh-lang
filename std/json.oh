// json: lightweight field extraction over a flat JSON object (no allocation).
// json_int(buf,key): integer value for "key" (signed). Returns -1 if not found.
// Searches for the (bare) key, scans past ':' and spaces, parses [-]digits.
#json_int(buf:c,key:c){
k:=sfind(buf,key)
?k<0{\-1}
i:=k+slen(key)
~buf[i]!=58{i=i+1}
i=i+1
~buf[i]==32{i=i+1}
neg:=0
?buf[i]==45{
neg=1
i=i+1}
n:=0
~buf[i]>=48&&buf[i]<=57{
n=n*10+(3)(buf[i])-48
i=i+1}
neg==1?0-n:n}
// json_has(buf,key): 1 if key present, else 0
#json_has(buf:c,key:c)sfind(buf,key)>=0?1:0
