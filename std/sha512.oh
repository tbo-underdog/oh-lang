// SHA-512 (FIPS 180-4). 64-bit words; Oh >> is arithmetic so we use a masked
// logical shift lsr64(). Needs std/core. For Ed25519 (RFC 8032).
#lsr64(x:6,n:6):6{(x>>n)&(((6)1<<(64-n))-1)}
#ror64(x:6,n:6):6{lsr64(x,n)|(x<<(64-n))}
#ld64(b:c,o):6{
v:=(6)0
@i,8{v=(v<<8)|((6)b[o+i]&255)}
v}
#st64(b:c,o,v:6):v{@i,8{b[o+i]=(1)((v>>((7-i)*8))&255)}}
#sha512(msg:c,len,out:c):v{
