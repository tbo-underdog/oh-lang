// AES-GCM (AEAD) per NIST SP 800-38D, 96-bit IV. Needs std/core, std/aes.
// Pass precomputed round keys (aes_expand) + S-box. gf_mult is the bitwise GF(2^128)
// multiply (correct, not fast); fine for handshakes/small records.

// out = x * h in GF(2^128) (GCM bit convention, byte 0 = most significant)
#gf_mult(x:c,y:c,out:c):v{
z:[16]1=0
v:[16]1=0
@i,16{v[i]=y[i]}
i:=0
~i<128{
?((((3)x[i/8]&255)>>(7-i%8))&1)==1{@k,16{z[k]=(1)((3)z[k]^(3)v[k])}}
carry:=0
@b,16{
hb:=(3)v[b]&1
v[b]=(1)((((3)v[b]&255)>>1)|(carry<<7))
carry=hb
}
?carry==1{v[0]=(1)((3)v[0]^0xe1)}
i=i+1
}
@i,16{out[i]=z[i]}}
// y = (y ^ blk) * h
#ghash_block(y:c,h:c,blk:c):v{
@i,16{y[i]=(1)((3)y[i]^(3)blk[i])}
t:[16]1=0
gf_mult(y,h,t)
@i,16{y[i]=t[i]}}
// feed `len` bytes of data into y as zero-padded 16-byte blocks
#ghash_feed(y:c,h:c,data:c,len):v{
off:=0
~off<len{
blk:[16]1=0
n:=len-off
?n>16{n=16}
@i,n{blk[i]=data[off+i]}
ghash_block(y,h,blk)
off=off+16
}}
#ghash(h:c,aad:c,aadlen,ct:c,ctlen,out:c):v{
y:[16]1=0
ghash_feed(y,h,aad,aadlen)
ghash_feed(y,h,ct,ctlen)
lb:[16]1=0
ab:=(6)aadlen*8
cb:=(6)ctlen*8
@i,8{lb[7-i]=(1)((ab>>(i*8))&255)}
@i,8{lb[15-i]=(1)((cb>>(i*8))&255)}
ghash_block(y,h,lb)
@i,16{out[i]=y[i]}}
// increment the last 32 bits (big-endian) of a 16-byte counter block
#inc32(b:c):v{
i:=15
~i>=12{
v:=((3)b[i]&255)+1
b[i]=(1)(v&255)
?v<256{\}
i=i-1
}}
// AES-GCM encrypt: iv(12) + aad + pt -> ct (ptlen bytes) + tag(16). rk/nr/sb precomputed.
#aes_gcm_encrypt(rk:c,nr:6,sb:c,iv:c,aad:c,aadlen,pt:c,ptlen,ct:c,tag:c):v{
zero:[16]1=0
h:[16]1=0
aes_encrypt(rk,nr,sb,zero,h)
j0:[16]1=0
@i,12{j0[i]=iv[i]}
j0[15]=(1)1
ej0:[16]1=0
aes_encrypt(rk,nr,sb,j0,ej0)
ctr:[16]1=0
@i,16{ctr[i]=j0[i]}
ks:[16]1=0
off:=0
~off<ptlen{
inc32(ctr)
aes_encrypt(rk,nr,sb,ctr,ks)
blk:=ptlen-off
?blk>16{blk=16}
@i,blk{ct[off+i]=(1)((3)pt[off+i]^(3)ks[i])}
off=off+16
}
s:[16]1=0
ghash(h,aad,aadlen,ct,ptlen,s)
@i,16{tag[i]=(1)((3)s[i]^(3)ej0[i])}}
// AES-GCM decrypt: verifies tag, returns 1 if ok (and fills pt), 0 if tag mismatch.
#aes_gcm_decrypt(rk:c,nr:6,sb:c,iv:c,aad:c,aadlen,ct:c,ctlen,tag:c,pt:c):6{
zero:[16]1=0
h:[16]1=0
aes_encrypt(rk,nr,sb,zero,h)
j0:[16]1=0
@i,12{j0[i]=iv[i]}
j0[15]=(1)1
ej0:[16]1=0
aes_encrypt(rk,nr,sb,j0,ej0)
s:[16]1=0
ghash(h,aad,aadlen,ct,ctlen,s)
diff:=0
@i,16{diff=diff|((3)s[i]^(3)ej0[i]^(3)tag[i])}
?diff!=0{\0}
ctr:[16]1=0
@i,16{ctr[i]=j0[i]}
ks:[16]1=0
off:=0
~off<ctlen{
inc32(ctr)
aes_encrypt(rk,nr,sb,ctr,ks)
blk:=ctlen-off
?blk>16{blk=16}
@i,blk{pt[off+i]=(1)((3)ct[off+i]^(3)ks[i])}
off=off+16
}
1}
