// sha256 + HMAC-SHA256 + PBKDF2-HMAC-SHA256. Pure byte functions, no libc.
// 32-bit word math in 64-bit registers, masked with 0xffffffff. Streaming block-wise
// compression: input length is unbounded (no fixed scratch buffer for the message).

#ror(x:6,n:6):6{((x>>n)|(x<<(32-n)))&0xffffffff}
#shr(x:6,n:6):6{(x>>n)&0xffffffff}
// load big-endian u32 from b at off
#ld32(b:c,o):6{((((6)b[o]&255)<<24)|(((6)b[o+1]&255)<<16)|(((6)b[o+2]&255)<<8)|((6)b[o+3]&255))&0xffffffff}
// store big-endian u32 v into b at off
#st32(b:c,o:6,v:6):v{
b[o]=(1)((v>>24)&255)
b[o+1]=(1)((v>>16)&255)
b[o+2]=(1)((v>>8)&255)
b[o+3]=(1)(v&255)}
// load the 64 round constants
#sha256_k(k:*6):v{
k[0]=0x428a2f98 k[1]=0x71374491 k[2]=0xb5c0fbcf k[3]=0xe9b5dba5
k[4]=0x3956c25b k[5]=0x59f111f1 k[6]=0x923f82a4 k[7]=0xab1c5ed5
k[8]=0xd807aa98 k[9]=0x12835b01 k[10]=0x243185be k[11]=0x550c7dc3
k[12]=0x72be5d74 k[13]=0x80deb1fe k[14]=0x9bdc06a7 k[15]=0xc19bf174
k[16]=0xe49b69c1 k[17]=0xefbe4786 k[18]=0x0fc19dc6 k[19]=0x240ca1cc
k[20]=0x2de92c6f k[21]=0x4a7484aa k[22]=0x5cb0a9dc k[23]=0x76f988da
k[24]=0x983e5152 k[25]=0xa831c66d k[26]=0xb00327c8 k[27]=0xbf597fc7
k[28]=0xc6e00bf3 k[29]=0xd5a79147 k[30]=0x06ca6351 k[31]=0x14292967
k[32]=0x27b70a85 k[33]=0x2e1b2138 k[34]=0x4d2c6dfc k[35]=0x53380d13
k[36]=0x650a7354 k[37]=0x766a0abb k[38]=0x81c2c92e k[39]=0x92722c85
k[40]=0xa2bfe8a1 k[41]=0xa81a664b k[42]=0xc24b8b70 k[43]=0xc76c51a3
k[44]=0xd192e819 k[45]=0xd6990624 k[46]=0xf40e3585 k[47]=0x106aa070
k[48]=0x19a4c116 k[49]=0x1e376c08 k[50]=0x2748774c k[51]=0x34b0bcb5
k[52]=0x391c0cb3 k[53]=0x4ed8aa4a k[54]=0x5b9cca4f k[55]=0x682e6ff3
k[56]=0x748f82ee k[57]=0x78a5636f k[58]=0x84c87814 k[59]=0x8cc70208
k[60]=0x90befffa k[61]=0xa4506ceb k[62]=0xbef9a3f7 k[63]=0xc67178f2}
// compress one 64-byte block at blk into running state h[0..8) (k = round constants)
#sha256_block(blk:c,k:*6,h:*6):v{
w:[64]6=0
@t,16{w[t]=ld32(blk,t*4)}
@t=16,64{
s0:=ror(w[t-15],7)^ror(w[t-15],18)^shr(w[t-15],3)
s1:=ror(w[t-2],17)^ror(w[t-2],19)^shr(w[t-2],10)
w[t]=(w[t-16]+s0+w[t-7]+s1)&0xffffffff}
a:=h[0] b:=h[1] c:=h[2] d:=h[3] e:=h[4] f:=h[5] g:=h[6] hh:=h[7]
@t,64{
bs1:=ror(e,6)^ror(e,11)^ror(e,25)
ch:=(e&f)^((e^0xffffffff)&g)
t1:=(hh+bs1+ch+k[t]+w[t])&0xffffffff
bs0:=ror(a,2)^ror(a,13)^ror(a,22)
mj:=(a&b)^(a&c)^(b&c)
t2:=(bs0+mj)&0xffffffff
hh=g g=f f=e e=(d+t1)&0xffffffff d=c c=b b=a a=(t1+t2)&0xffffffff}
h[0]=(h[0]+a)&0xffffffff h[1]=(h[1]+b)&0xffffffff h[2]=(h[2]+c)&0xffffffff h[3]=(h[3]+d)&0xffffffff
h[4]=(h[4]+e)&0xffffffff h[5]=(h[5]+f)&0xffffffff h[6]=(h[6]+g)&0xffffffff h[7]=(h[7]+hh)&0xffffffff}
// initialize state h to the SHA-256 IV
#sha256_init(h:*6):v{
h[0]=(6)0x6a09e667 h[1]=(6)0xbb67ae85 h[2]=(6)0x3c6ef372 h[3]=(6)0xa54ff53a
h[4]=(6)0x510e527f h[5]=(6)0x9b05688c h[6]=(6)0x1f83d9ab h[7]=(6)0x5be0cd19}
// finish: `rem` (<64) trailing bytes at src, total message bit-length, append padding,
// process the final 1-2 blocks, write the 32-byte digest to out.
#sha256_finish(h:*6,k:*6,src:c,rem,totalbits:6,out:c):v{
tail:[128]1=0
@i,rem{tail[i]=src[i]}
tail[rem]=(1)0x80
lenpos:=56
?rem>=56{lenpos=120}
st32(tail,lenpos,(totalbits>>32)&0xffffffff)
st32(tail,lenpos+4,totalbits&0xffffffff)
sha256_block(&tail[0],k,h)
?rem>=56{sha256_block(&tail[64],k,h)}
st32(out,0,h[0]) st32(out,4,h[1]) st32(out,8,h[2]) st32(out,12,h[3])
st32(out,16,h[4]) st32(out,20,h[5]) st32(out,24,h[6]) st32(out,28,h[7])}
// sha256(msg[0..len)) -> out[0..32). Length unbounded (block-wise, no message copy).
#sha256(msg:c,len,out:c):v{
k:[64]6=0 sha256_k(k)
h:[8]6=0 sha256_init(h)
nfull:=len/64
bi:=0
~bi<nfull{sha256_block(&msg[bi*64],k,h) bi=bi+1}
rem:=len-nfull*64
sha256_finish(h,k,&msg[nfull*64],rem,(6)len*8,out)}
// HMAC-SHA256(key[0..klen), msg[0..mlen)) -> out[0..32). msg length unbounded.
#hmac(key:c,klen,msg:c,mlen,out:c):v{
k:[64]6=0 sha256_k(k)
kb:[64]1=0
?klen>64{sha256(key,klen,kb)}:{@i,klen{kb[i]=key[i]}}
ipad:[64]1=0
@i,64{ipad[i]=(1)((3)kb[i]^0x36)}
h:[8]6=0 sha256_init(h)
sha256_block(ipad,k,h)
nfull:=mlen/64
bi:=0
~bi<nfull{sha256_block(&msg[bi*64],k,h) bi=bi+1}
rem:=mlen-nfull*64
ih:[32]1=0
sha256_finish(h,k,&msg[nfull*64],rem,(6)(64+mlen)*8,ih)
opad:[64]1=0
@i,64{opad[i]=(1)((3)kb[i]^0x5c)}
h2:[8]6=0 sha256_init(h2)
sha256_block(opad,k,h2)
sha256_finish(h2,k,ih,32,(6)96*8,out)}
// PBKDF2-HMAC-SHA256, one output block (dklen=32) -> out[0..32).
#pbkdf2(pass:c,plen,salt:c,slen,iter,out:c):v{
si:[1100]1=0
@i,slen{si[i]=salt[i]}
si[slen]=(1)0 si[slen+1]=(1)0 si[slen+2]=(1)0 si[slen+3]=(1)1
u:[32]1=0
hmac(pass,plen,si,slen+4,u)
@i,32{out[i]=u[i]}
c:=1
~c<iter{
un:[32]1=0
hmac(pass,plen,u,32,un)
@i,32{u[i]=un[i] out[i]=(1)((3)out[i]^(3)un[i])}
c=c+1}}
