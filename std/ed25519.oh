// Ed25519 signature verification (RFC 8032). Reuses std/x25519 field ops
// (fmul/fsum/fsub/fcarry/finv/fexpand/fcontract). Needs std/core, std/x25519,
// std/sha512. Point = 40 i64 (X=0..9,Y=10..19,Z=20..29,T=30..39).
// equal field elements? (1/0) via canonical 32-byte contraction
#feq(a:*6,b:*6):6{
ba:[32]1=0 bb:[32]1=0
fcontract(ba,a) fcontract(bb,b)
?memcmp(ba,bb,32)==0{\1}
0}
// low bit of a field element
#flsb(a:*6):6{
ba:[32]1=0 fcontract(ba,a)
(3)ba[0]&1}
// out = a^((p+3)/8)  (exponent 2^252-2: byte0=0xfe, b1..30=0xff, b31=0x0f)
#fsqexp(out:*6,a:*6):v{
e:[32]1=0 e[0]=(1)0xfe @i=1,31{e[i]=(1)0xff} e[31]=(1)0x0f
r:[10]6=0 r[0]=1
i:=251
~i>=0{
fmul(r,r,r)
?((((3)e[i/8]&255)>>(i%8))&1)==1{fmul(r,r,a)}
i=i-1
}
@k,10{out[k]=r[k]}}
// recover x from y (Edwards). writes x into out.
#xrecover(out:*6,y:*6):v{
db:[32]1=0
db[0]=(1)0xa3
db[1]=(1)0x78
db[2]=(1)0x59
db[3]=(1)0x13
db[4]=(1)0xca
db[5]=(1)0x4d
db[6]=(1)0xeb
db[7]=(1)0x75
db[8]=(1)0xab
db[9]=(1)0xd8
db[10]=(1)0x41
db[11]=(1)0x41
db[12]=(1)0x4d
db[13]=(1)0x0a
db[14]=(1)0x70
db[15]=(1)0x00
db[16]=(1)0x98
db[17]=(1)0xe8
db[18]=(1)0x79
db[19]=(1)0x77
db[20]=(1)0x79
db[21]=(1)0x40
db[22]=(1)0xc7
db[23]=(1)0x8c
db[24]=(1)0x73
db[25]=(1)0xfe
db[26]=(1)0x6f
db[27]=(1)0x2b
db[28]=(1)0xee
db[29]=(1)0x6c
db[30]=(1)0x03
db[31]=(1)0x52
ib:[32]1=0
ib[0]=(1)0xb0
ib[1]=(1)0xa0
ib[2]=(1)0x0e
ib[3]=(1)0x4a
ib[4]=(1)0x27
ib[5]=(1)0x1b
ib[6]=(1)0xee
ib[7]=(1)0xc4
ib[8]=(1)0x78
ib[9]=(1)0xe4
ib[10]=(1)0x2f
ib[11]=(1)0xad
ib[12]=(1)0x06
ib[13]=(1)0x18
ib[14]=(1)0x43
ib[15]=(1)0x2f
ib[16]=(1)0xa7
ib[17]=(1)0xd7
ib[18]=(1)0xfb
ib[19]=(1)0x3d
ib[20]=(1)0x99
ib[21]=(1)0x00
ib[22]=(1)0x4d
ib[23]=(1)0x2b
ib[24]=(1)0x0b
ib[25]=(1)0xdf
ib[26]=(1)0xc1
ib[27]=(1)0x4f
ib[28]=(1)0x80
ib[29]=(1)0x24
ib[30]=(1)0x83
ib[31]=(1)0x2b
dfe:[10]6=0 fexpand(dfe,db)
ife:[10]6=0 fexpand(ife,ib)
one:[10]6=0 one[0]=1
zero:[10]6=0
y2:[10]6=0 fmul(y2,y,y)
u:[10]6=0 fsub(u,y2,one)
v:[10]6=0 fmul(v,dfe,y2) fsum(v,v,one)
vi:[10]6=0 finv(vi,v)
x:[10]6=0 fmul(x,u,vi)
fsqexp(x,x)
chk:[10]6=0 fmul(chk,x,x) fmul(chk,chk,v)
?feq(chk,u)==0{fmul(x,x,ife)}
?flsb(x)==1{fsub(x,zero,x) fcarry(x)}
@k,10{out[k]=x[k]}}
// decode 32-byte point -> P(40). returns 1.
#ed_decode(P:*6,s:c):6{
yfe:[10]6=0 fexpand(yfe,s)
xfe:[10]6=0 xrecover(xfe,yfe)
sign:=(((3)s[31]&255)>>7)&1
zero:[10]6=0
?flsb(xfe)!=sign{fsub(xfe,zero,xfe) fcarry(xfe)}
@k,10{P[k]=xfe[k]}
@k,10{P[10+k]=yfe[k]}
P[20]=1 @k=21,30{P[k]=0}
fmul(&P[30],xfe,yfe)
1}
// encode P(40) -> 32 bytes
#ed_encode(out:c,P:*6):v{
zi:[10]6=0 finv(zi,&P[20])
xx:[10]6=0 fmul(xx,&P[0],zi)
yy:[10]6=0 fmul(yy,&P[10],zi)
fcontract(out,yy)
out[31]=(1)(((3)out[31]&255)|(flsb(xx)<<7))}
// P3 = P1 + P2 (extended coords). o may alias P1/P2 (o written last).
#ed_add(o:*6,P:*6,Q:*6):v{
db2:[32]1=0
db2[0]=(1)0xa3
db2[1]=(1)0x78
db2[2]=(1)0x59
db2[3]=(1)0x13
db2[4]=(1)0xca
db2[5]=(1)0x4d
db2[6]=(1)0xeb
db2[7]=(1)0x75
db2[8]=(1)0xab
db2[9]=(1)0xd8
db2[10]=(1)0x41
db2[11]=(1)0x41
db2[12]=(1)0x4d
db2[13]=(1)0x0a
db2[14]=(1)0x70
db2[15]=(1)0x00
db2[16]=(1)0x98
db2[17]=(1)0xe8
db2[18]=(1)0x79
db2[19]=(1)0x77
db2[20]=(1)0x79
db2[21]=(1)0x40
db2[22]=(1)0xc7
db2[23]=(1)0x8c
db2[24]=(1)0x73
db2[25]=(1)0xfe
db2[26]=(1)0x6f
db2[27]=(1)0x2b
db2[28]=(1)0xee
db2[29]=(1)0x6c
db2[30]=(1)0x03
db2[31]=(1)0x52
dfe:[10]6=0 fexpand(dfe,db2)
two:[10]6=0 two[0]=2
A:[10]6=0 Bb:[10]6=0 C:[10]6=0 D:[10]6=0 E:[10]6=0 Fr:[10]6=0 G:[10]6=0 H:[10]6=0 t:[10]6=0
fsub(A,&P[10],&P[0]) fsub(t,&Q[10],&Q[0]) fmul(A,A,t)
fsum(Bb,&P[10],&P[0]) fsum(t,&Q[10],&Q[0]) fmul(Bb,Bb,t)
fmul(C,&P[30],&Q[30]) fmul(C,C,dfe) fmul(C,C,two)
fmul(D,&P[20],&Q[20]) fmul(D,D,two)
fsub(E,Bb,A) fsub(Fr,D,C) fsum(G,D,C) fsum(H,Bb,A)
fmul(&o[0],E,Fr) fmul(&o[10],G,H) fmul(&o[20],Fr,G) fmul(&o[30],E,H)}
// o = e * P  (e = 32-byte LE scalar). double-and-add over 256 bits.
#ed_scalarmult(o:*6,P:*6,e:c):v{
@k,40{o[k]=0} o[10]=1 o[20]=1
i:=255
~i>=0{
ed_add(o,o,o)
?((((3)e[i/8]&255)>>(i%8))&1)==1{ed_add(o,o,P)}
i=i-1
}}
// reduce 64-byte little-endian x (as i64 coeffs) mod L -> 32-byte r
#modL(r:c,x:*6):v{
Lb:[32]1=0
Lb[0]=(1)0xed
Lb[1]=(1)0xd3
Lb[2]=(1)0xf5
Lb[3]=(1)0x5c
Lb[4]=(1)0x1a
Lb[5]=(1)0x63
Lb[6]=(1)0x12
Lb[7]=(1)0x58
Lb[8]=(1)0xd6
Lb[9]=(1)0x9c
Lb[10]=(1)0xf7
Lb[11]=(1)0xa2
Lb[12]=(1)0xde
Lb[13]=(1)0xf9
Lb[14]=(1)0xde
Lb[15]=(1)0x14
Lb[16]=(1)0x00
Lb[17]=(1)0x00
Lb[18]=(1)0x00
Lb[19]=(1)0x00
Lb[20]=(1)0x00
Lb[21]=(1)0x00
Lb[22]=(1)0x00
Lb[23]=(1)0x00
Lb[24]=(1)0x00
Lb[25]=(1)0x00
Lb[26]=(1)0x00
Lb[27]=(1)0x00
Lb[28]=(1)0x00
Lb[29]=(1)0x00
Lb[30]=(1)0x00
Lb[31]=(1)0x10
i:=63
~i>=32{
carry:=(6)0
j:=i-32
~j<i-12{
x[j]=x[j]+carry-16*x[i]*((3)Lb[j-(i-32)]&255)
carry=(x[j]+128)>>8
x[j]=x[j]-(carry<<8)
j=j+1
}
x[j]=x[j]+carry
x[i]=0
i=i-1
}
carry:=(6)0
j:=0
~j<32{
x[j]=x[j]+carry-(x[31]>>4)*((3)Lb[j]&255)
carry=x[j]>>8
x[j]=x[j]&255
j=j+1
}
j=0 ~j<32{x[j]=x[j]-carry*((3)Lb[j]&255) j=j+1}
i=0
~i<32{
x[i+1]=x[i+1]+(x[i]>>8)
r[i]=(1)(x[i]&255)
i=i+1
}}
// verify ed25519 signature sig(64) over msg by public key pub(32). 1=ok.
#ed25519_verify(pub:c,msg:c,msglen,sig:c):6{
hin:[2048]1=0
@i,32{hin[i]=sig[i]}
@i,32{hin[32+i]=pub[i]}
@i,msglen{hin[64+i]=msg[i]}
hash:[64]1=0 sha512(hin,64+msglen,hash)
x:[64]6=0 @i,64{x[i]=(6)((3)hash[i]&255)}
kb:[32]1=0 modL(kb,x)
bxb:[32]1=0
bxb[0]=(1)0x1a
bxb[1]=(1)0xd5
bxb[2]=(1)0x25
bxb[3]=(1)0x8f
bxb[4]=(1)0x60
bxb[5]=(1)0x2d
bxb[6]=(1)0x56
bxb[7]=(1)0xc9
bxb[8]=(1)0xb2
