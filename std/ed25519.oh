bxb[27]=(1)0xcd
bxb[28]=(1)0xd3
bxb[29]=(1)0x36
bxb[30]=(1)0x69
bxb[31]=(1)0x21
byb:[32]1=0
byb[0]=(1)0x58
byb[1]=(1)0x66
byb[2]=(1)0x66
byb[3]=(1)0x66
byb[4]=(1)0x66
byb[5]=(1)0x66
byb[6]=(1)0x66
byb[7]=(1)0x66
byb[8]=(1)0x66
byb[9]=(1)0x66
byb[10]=(1)0x66
byb[11]=(1)0x66
byb[12]=(1)0x66
byb[13]=(1)0x66
byb[14]=(1)0x66
byb[15]=(1)0x66
byb[16]=(1)0x66
byb[17]=(1)0x66
byb[18]=(1)0x66
byb[19]=(1)0x66
