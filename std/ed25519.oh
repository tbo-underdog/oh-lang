byb[27]=(1)0x66
byb[28]=(1)0x66
byb[29]=(1)0x66
byb[30]=(1)0x66
byb[31]=(1)0x66
B:[40]6=0
fexpand(&B[0],bxb) fexpand(&B[10],byb) B[20]=1 fmul(&B[30],&B[0],&B[10])
Rp:[40]6=0 ed_decode(Rp,sig)
Ap:[40]6=0 ed_decode(Ap,pub)
sB:[40]6=0 ed_scalarmult(sB,B,&sig[32])
kA:[40]6=0 ed_scalarmult(kA,Ap,kb)
RkA:[40]6=0 ed_add(RkA,Rp,kA)
e1:[32]1=0 e2:[32]1=0
ed_encode(e1,sB) ed_encode(e2,RkA)
?memcmp(e1,e2,32)==0{\1}
0}
