// core: bytes, memory, int<->ascii
#slen(s:c){i:=0 ~s[i]!=0{i=i+1} i}
#bcopy(d:c,off,s:c){i:=0 ~s[i]!=0{d[off+i]=s[i] i=i+1} off+i}
#memcpy(d:c,s:c,n):v{@i,n{d[i]=s[i]}}
#memset(d:c,v,n):v{@i,n{d[i]=(1)v}}
#memcmp(a:c,b:c,n){
pa:=(*6)a
pb:=(*6)b
w:=n/8
@i,w{?pa[i]!=pb[i]{\1}}
@j=w*8,n{?a[j]!=b[j]{\1}}
0}
#itoa(d:c,off,n){
?n==0{
d[off]=48
\off+1}
t:=n
c:=0
~t>0{
c=c+1
t=t/10}
i:=off+c
~n>0{
i=i-1
d[i]=(1)(48+n%10)
n=n/10}
off+c}
