// TLS 1.3 key schedule (RFC 8446 §7.1). Needs std/core, std/sha256, std/hkdf.
// HKDF-Expand-Label and Derive-Secret over SHA-256 (TLS_AES_128_GCM_SHA256).

// HKDF-Expand-Label(secret, label, context, length) -> out[0..length).
// HkdfLabel = uint16(length) | uint8(len("tls13 "+label)) | "tls13 "+label
//             | uint8(len(context)) | context
#tls_expand_label(secret:c,label:c,llen,ctx:c,clen,length,out:c):v{
info:[256]1=0
info[0]=(1)((length>>8)&255)
info[1]=(1)(length&255)
o:=2
fl:=6+llen
info[o]=(1)fl
o=o+1
o=bcopy(info,o,"tls13 ")
@i,llen{info[o+i]=label[i]}
o=o+llen
info[o]=(1)clen
o=o+1
@i,clen{info[o+i]=ctx[i]}
o=o+clen
hkdf_expand(secret,info,o,length,out)}
// Derive-Secret(secret, label, messages) = Expand-Label(secret, label, H(messages), 32)
#tls_derive_secret(secret:c,label:c,llen,msgs:c,msglen,out:c):v{
h:[32]1=0
sha256(msgs,msglen,h)
tls_expand_label(secret,label,llen,h,32,32,out)}
// Full handshake key schedule for (EC)DHE-only (no PSK). Given the transcript hash
// `hs_hash` = H(ClientHello..ServerHello) and the 32-byte ECDHE shared secret, derive
// the client/server handshake traffic secrets into cs/ss (32 bytes each) and the
// handshake_secret into hs (32 bytes, for the later master-secret step).
#tls_handshake_secrets(shared:c,hs_hash:c,hs:c,cs:c,ss:c):v{
z:[32]1=0
early:[32]1=0
hkdf_extract(z,32,z,32,early)
derived:[32]1=0
tls_derive_secret(early,"derived",7,z,0,derived)
hkdf_extract(derived,32,shared,32,hs)
tls_expand_label(hs,"c hs traffic",12,hs_hash,32,32,cs)
tls_expand_label(hs,"s hs traffic",12,hs_hash,32,32,ss)}
// Traffic key + iv from a traffic secret (AES-128-GCM: 16-byte key, 12-byte iv).
#tls_traffic_keyiv(secret:c,key:c,iv:c):v{
tls_expand_label(secret,"key",3,key,0,16,key)
tls_expand_label(secret,"iv",2,iv,0,12,iv)}
