#xtime(x:6):6{
r:=(x<<1)&255
?(x&128)!=0{r=r^0x1b}
r}
#aes_expand(key:c,keylen,sb:c,rk:c):6{
nk:=keylen/4
nr:=nk+6
@i,keylen{rk[i]=key[i]}
i:=nk
rcon:=(6)1
~i<4*(nr+1){
t0:=(6)rk[(i-1)*4]&255
t1:=(6)rk[(i-1)*4+1]&255
t2:=(6)rk[(i-1)*4+2]&255
t3:=(6)rk[(i-1)*4+3]&255
?i%nk==0{
tmp:=t0
t0=t1 t1=t2 t2=t3 t3=tmp
t0=(6)sb[t0]&255
t1=(6)sb[t1]&255
t2=(6)sb[t2]&255
t3=(6)sb[t3]&255
t0=t0^rcon
rcon=xtime(rcon)
}:{
?nk>6&&i%nk==4{
t0=(6)sb[t0]&255
t1=(6)sb[t1]&255
t2=(6)sb[t2]&255
t3=(6)sb[t3]&255
}
}
rk[i*4]=(1)((6)rk[(i-nk)*4]^t0)
rk[i*4+1]=(1)((6)rk[(i-nk)*4+1]^t1)
rk[i*4+2]=(1)((6)rk[(i-nk)*4+2]^t2)
rk[i*4+3]=(1)((6)rk[(i-nk)*4+3]^t3)
i=i+1
}
nr}
#aes_shiftrows(s:c):v{
t:=(3)s[1]&255
s[1]=s[5] s[5]=s[9] s[9]=s[13] s[13]=(1)t
t=(3)s[2]&255
u:=(3)s[6]&255
s[2]=s[10] s[6]=s[14] s[10]=(1)t s[14]=(1)u
t=(3)s[15]&255
s[15]=s[11] s[11]=s[7] s[7]=s[3] s[3]=(1)t}
#aes_mixcols(s:c):v{
c:=0
~c<4{
a0:=(6)s[c*4]&255
a1:=(6)s[c*4+1]&255
a2:=(6)s[c*4+2]&255
a3:=(6)s[c*4+3]&255
s[c*4]=(1)(xtime(a0)^(xtime(a1)^a1)^a2^a3)
s[c*4+1]=(1)(a0^xtime(a1)^(xtime(a2)^a2)^a3)
s[c*4+2]=(1)(a0^a1^xtime(a2)^(xtime(a3)^a3))
s[c*4+3]=(1)((xtime(a0)^a0)^a1^a2^xtime(a3))
c=c+1
}}
#aes_encrypt(rk:c,nr:6,sb:c,in:c,out:c):v{
s:[16]1=0
@i,16{s[i]=(1)((3)in[i]^(3)rk[i])}
r:=1
~r<nr{
@i,16{s[i]=sb[(3)s[i]&255]}
aes_shiftrows(s)
aes_mixcols(s)
@i,16{s[i]=(1)((3)s[i]^(3)rk[r*16+i])}
r=r+1
}
@i,16{s[i]=sb[(3)s[i]&255]}
aes_shiftrows(s)
@i,16{out[i]=(1)((3)s[i]^(3)rk[nr*16+i])}}
