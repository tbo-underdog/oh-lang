// vec: fixed-capacity i32 array on a heap (needs std/mem). Size is chosen at
// creation (vec_new cap) — the Oh model: you know the size when you make it.
// push does NOT grow (no heap param, no realloc, no orphan-leak path); it aborts
// (137) if you exceed cap. That keeps the hot path a branchless store+increment.
$Vec{data:*3 len:3 cap:3}
#vec_new(v:*Vec,h:*6,cap):v{
v.data=(*3)halloc(h,(6)cap*4)
v.len=0
v.cap=cap}
#vec_push(v:*Vec,x):v{
?v.len>=v.cap{sys(60,137)}
d:=v.data
d[v.len]=x
v.len=v.len+1}
#vec_get(v:*Vec,i){
d:=v.data
d[i]}
#vec_set(v:*Vec,i,x):v{
d:=v.data
d[i]=x}
#vec_len(v:*Vec)v.len
#vec_pop(v:*Vec){
v.len=v.len-1
d:=v.data
d[v.len]}
