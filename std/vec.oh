// vec: growable i32 array on a heap. State v:[3]6 = [dataptr, len, cap].
// Needs std/mem. Pointers are i64 addrs; explicit casts bridge i64<->i32.
#vec_new(v:*6,h:*6,cap):v{
v[0]=halloc(h,(6)(cap*4))
v[1]=0
v[2]=(6)cap}
#vec_push(v:*6,h:*6,x):v{
?v[1]>=v[2]{
nc:=v[2]*2
nd:=halloc(h,(6)(nc*4))
old:=(*3)v[0]
nw:=(*3)nd
@i,(3)v[1]{nw[i]=old[i]}
v[0]=nd
v[2]=nc}
d:=(*3)v[0]
li:=(3)v[1]
d[li]=x
v[1]=v[1]+1}
#vec_get(v:*6,i){
d:=(*3)v[0]
d[i]}
#vec_set(v:*6,i,x):v{
d:=(*3)v[0]
d[i]=x}
#vec_len(v:*6)(3)v[1]
#vec_pop(v:*6){
v[1]=v[1]-1
d:=(*3)v[0]
li:=(3)v[1]
d[li]}
