// vec: growable i32 array on a heap (needs std/mem). Struct-typed state — pass a
// Vec value, it decays to *Vec. Typed `data` field removes the per-access cast.
$Vec{data:*3 len:3 cap:3}
#vec_new(v:*Vec,h:*6,cap):v{
v.data=(*3)halloc(h,cap*4)
v.len=0
v.cap=cap}
#vec_push(v:*Vec,h:*6,x):v{
?v.len>=v.cap{
nc:=v.cap*2
v.data=(*3)hrealloc(h,(6)v.data,v.cap*4,nc*4)
v.cap=nc}
d:=v.data
d[v.len]=x
v.len=v.len+1}
#vec_get(v:*Vec,i){
d:=v.data
d[i]}
#vec_set(v:*Vec,i,x):v{
d:=v.data
d[i]=x}
#vec_len(v:*Vec)v.len
#vec_pop(v:*Vec){
v.len=v.len-1
d:=v.data
d[v.len]}
