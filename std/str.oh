// str: comparisons, parsing, search
#streq(a:c,b:c){
i:=0
~1{
ca:=a[i]
cb:=b[i]
?ca!=cb{\0}
?ca==0{\1}
i=i+1}
0}
#starts(s:c,p:c){
i:=0
~p[i]!=0{
?s[i]!=p[i]{\0}
i=i+1}
1}
#atoi(s:c){
n:=0
i:=0
~s[i]>=48&&s[i]<=57{n=n*10+(3)(s[i])-48 i=i+1}
n}
#sfind(h:c,nd:c){
hl:=slen(h)
nl:=slen(nd)
@i,hl-nl+1{
m:=1
@j,nl{?h[i+j]!=nd[j]{m=0}}
?m==1{\i}}
-1}
