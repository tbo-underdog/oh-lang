// map: fixed-capacity int->int hash map on a heap (open addressing, linear probe).
// Needs std/mem. Struct-typed state — pass a Map value, it decays to *Map. Typed
// pointer fields remove the per-access casts. cap must be a power of two and
// exceed the number of entries. map_get/has return -1/0 if absent.
$Map{keys:*3 vals:*3 flags:*1 count:3 cap:3}
#map_new(m:*Map,h:*6,cap):v{
m.keys=(*3)halloc(h,cap*4)
m.vals=(*3)halloc(h,cap*4)
m.flags=(*1)halloc(h,cap)
fl:=m.flags
@i,cap{fl[i]=0}
m.count=0
m.cap=cap}
#map_set(m:*Map,k,v):v{
cap:=m.cap
keys:=m.keys
vals:=m.vals
fl:=m.flags
i:=k&(cap-1)
~fl[i]==1&&keys[i]!=k{i=(i+1)&(cap-1)}
?fl[i]==0{
?m.count+1>=cap{sys(60,137)}
fl[i]=1
m.count=m.count+1}
keys[i]=k
vals[i]=v}
#map_get(m:*Map,k){
cap:=m.cap
keys:=m.keys
vals:=m.vals
fl:=m.flags
i:=k&(cap-1)
~fl[i]==1{
?keys[i]==k{\vals[i]}
i=(i+1)&(cap-1)}
-1}
#map_has(m:*Map,k){
cap:=m.cap
keys:=m.keys
fl:=m.flags
i:=k&(cap-1)
~fl[i]==1{
?keys[i]==k{\1}
i=(i+1)&(cap-1)}
0}
#map_count(m:*Map)m.count
