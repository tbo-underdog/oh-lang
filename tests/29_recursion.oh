#fact(n){?n<=1{\1} \n*fact(n-1)}
#even(n){?n==0{\1} \odd(n-1)}
#odd(n){?n==0{\0} \even(n-1)}
#sumto(n,acc){?n==0{\acc} \sumto(n-1,acc+n)}
#countdown(n){?n==0{\0} \countdown(n-1)}
#fib(n){?n<=1{\n} \fib(n-1)+fib(n-2)}
#main():3{
?fact(5)!=120{\1}
?even(10)!=1{\2}
?odd(7)!=1{\3}
?sumto(100,0)!=5050{\4}
?fib(12)!=144{\5}
?countdown(5000000)!=0{\6}
0}
