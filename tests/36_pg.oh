// multi-column / multi-row walk. Build two DataRows: (1,"bob",NULL) then (42,"zoe").
// Row layout: 'D' + int32 len + int16 ncols + per col (int32 len + bytes; len -1 = NULL)
m:[128]1=0
o2:=0
// row A: ncols=3 -> "1","bob",NULL
m[o2]=68 o2=o2+1
la:=4+ 2+ (4+1) + (4+3) + 4      // lenfield + ncols + col0(len+1) + col1(len+3) + col2(NULL,len only)
be32w(m,o2,la) o2=o2+4
m[o2]=0 m[o2+1]=3 o2=o2+2
be32w(m,o2,1) o2=o2+4 m[o2]=49 o2=o2+1            // "1"
be32w(m,o2,3) o2=o2+4 m[o2]=98 m[o2+1]=111 m[o2+2]=98 o2=o2+3  // "bob"
be32w(m,o2,0-1) o2=o2+4                            // NULL
// row B: ncols=2 -> "42","zoe"
m[o2]=68 o2=o2+1
lb:=4+ 2 + (4+2) + (4+3)
be32w(m,o2,lb) o2=o2+4
m[o2]=0 m[o2+1]=2 o2=o2+2
be32w(m,o2,2) o2=o2+4 m[o2]=52 m[o2+1]=50 o2=o2+2   // "42"
be32w(m,o2,3) o2=o2+4 m[o2]=122 m[o2+1]=111 m[o2+2]=101 o2=o2+3  // "zoe"
// walk it
r0:=pg_nextrow(m,o2,0)
?r0!=0{\11}
?pg_ncols(m,r0)!=3{\12}
ob:[16]1=0
?pg_coln(m,r0,0,ob)!=1{\13}
