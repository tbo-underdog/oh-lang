?pg_coln(m,r0,1,ob)!=3{\15}
?memcmp(ob,"bob",3)!=0{\16}
?pg_coln(m,r0,2,ob)!=0-1{\17}              // NULL column
r1:=pg_nextrow(m,o2,r0+pg_msglen(m,r0))
?r1<=0{\18}
?pg_ncols(m,r1)!=2{\19}
?pg_coln(m,r1,0,ob)!=2{\20}
