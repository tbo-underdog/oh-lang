// SHA-512 (FIPS 180-4) — abc / empty / 112-byte 2-block vectors.
#tohex(b:c,n,out:c):v{
hd:="0123456789abcdef"
@i,n{out[i*2]=hd[((3)b[i]>>4)&15] out[i*2+1]=hd[(3)b[i]&15]}}
#main():3{
o:[64]1=0 hx:[160]1=0
sha512("abc",3,o) tohex(o,64,hx)
?memcmp(hx,"ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",128)!=0{\1}
sha512("",0,o) tohex(o,64,hx)
?memcmp(hx,"cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e",128)!=0{\2}
// 112-byte boundary (2-block)
sha512("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",112,o) tohex(o,64,hx)
?memcmp(hx,"8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909",128)!=0{\3}
