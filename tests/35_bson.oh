#main():3{
b:[128]1=0
w:=bson_begin(b,0)
w=bson_i32(b,w,"age",30)
w=bson_str(b,w,"name","alice",5)
w=bson_i32(b,w,"x",7)
w=bson_end(b,0,w)
?r32(b,0)!=w{\1}
oa:=bson_find(b,0,"age")
?oa<0{\2}
?r32(b,oa)!=30{\3}
on:=bson_find(b,0,"name")
?on<0{\4}
nm:[16]1=0
?bson_getstr(b,on,nm)!=5{\5}
?memcmp(nm,"alice",5)!=0{\6}
?r32(b,bson_find(b,0,"x"))!=7{\7}
?bson_find(b,0,"missing")!=0-1{\8}
0}
