#vec_new(v:*6,h:*6,cap):v{v[0]=halloc(h,(6)(cap*4)) v[1]=0 v[2]=(6)cap}
#vec_push(v:*6,h:*6,x):v{?v[1]>=v[2]{nc:=v[2]*2 nd:=halloc(h,(6)(nc*4)) old:=(*3)v[0] nw:=(*3)nd @i,(3)v[1]{nw[i]=old[i]} v[0]=nd v[2]=nc} d:=(*3)v[0] li:=(3)v[1] d[li]=x v[1]=v[1]+1}
#vec_get(v:*6,i){d:=(*3)v[0] d[i]}
#main(){
h:[3]6
heap_new(h,67108864)
v:[3]6
vec_new(v,h,16)
@i,1000000{vec_push(v,h,i&255)}
s:=0
@i,1000000{s=s+vec_get(v,i)}
s&255}
