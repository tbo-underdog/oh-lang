#map_new(m:*6,h:*6,cap):v{m[0]=halloc(h,(6)(cap*4)) m[1]=halloc(h,(6)(cap*4)) m[2]=halloc(h,(6)cap) fl:=(*1)m[2] @i,cap{fl[i]=0} m[3]=0 m[4]=(6)cap}
#map_set(m:*6,k,v):v{cap:=(3)m[4] keys:=(*3)m[0] vals:=(*3)m[1] fl:=(*1)m[2] i:=k&(cap-1) ~fl[i]==1&&keys[i]!=k{i=(i+1)&(cap-1)} ?fl[i]==0{fl[i]=1 m[3]=m[3]+1} keys[i]=k vals[i]=v}
#map_get(m:*6,k){cap:=(3)m[4] keys:=(*3)m[0] vals:=(*3)m[1] fl:=(*1)m[2] i:=k&(cap-1) ~fl[i]==1{?keys[i]==k{\vals[i]} i=(i+1)&(cap-1)} -1}
#main(){
h:[3]6
heap_new(h,67108864)
m:[5]6
map_new(m,h,2097152)
@i,1000000{map_set(m,i,i*2)}
s:=0
@i,1000000{s=s+map_get(m,i)}
