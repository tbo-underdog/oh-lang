// Secure PostgreSQL over TLS WITH SCRAM-SHA-256 password auth. SSLRequest -> TLS 1.3
// (std/tls.oh) -> Postgres startup + SCRAM handshake + query, all over the encrypted
// channel. Needs std/core,net,x25519,p256,sha256,sha512,hkdf,tls13,aes,gcm,ed25519,
// tls,pg,scram,b64.
#tls_recv_msg(t:*Tls,buf:c):6{
n:=(6)0
~1{
chunk:[16384]1=0
r:=tls_recv(t,chunk)
?r<0{\n}
@i,r{buf[n+i]=chunk[i]}
n=n+r
?n>=5{?1+be32r(buf,1)<=n{\n}}
}
n}
#tls_recv_z(t:*Tls,buf:c):6{
n:=(6)0
~pg_hasz(buf,(3)n)==0{
chunk:[16384]1=0
r:=tls_recv(t,chunk)
?r<0{\n}
@i,r{buf[n+i]=chunk[i]}
n=n+r
}
n}
#field(msg:c,n,key,out:c){
i:=0
~i<n{
?(i==0||(3)msg[i-1]==44)&&(3)msg[i]==key&&(3)msg[i+1]==61{
j:=i+2
o:=0
~j<n&&(3)msg[j]!=44{
out[o]=msg[j]
o=o+1
j=j+1}
\o}
i=i+1}
0-1}
#atoin(s:c,n){
v:=0
@i,n{v=v*10+((3)s[i]-48)}
v}
#find_auth(b:c,n,sub){
o:=0
~o+9<=n{
?(3)b[o]==82&&be32r(b,o+5)==sub{\o}
len:=be32r(b,o+1)
?len<=0{\0-1}
o=o+1+len}
0-1}
#main(){
fd:=connect_to(127,0,0,1,5432)
?fd<0{\1}
ssl:[8]1=0
ssl[3]=(1)8 ssl[4]=(1)0x04 ssl[5]=(1)0xd2 ssl[6]=(1)0x16 ssl[7]=(1)0x2f
sys(1,fd,&ssl[0],8)
resp:[1]1=0
sys(0,fd,&resp[0],1)
?(3)resp[0]!=83{\2}
sbx:[256]1=0 crk:[240]1=0 civ:[12]1=0 srk:[240]1=0 siv:[12]1=0 rbuf:[32768]1=0
t:Tls
t.fd=fd
t.sbx=(6)(&sbx[0]) t.crk=(6)(&crk[0]) t.civ=(6)(&civ[0])
t.srk=(6)(&srk[0]) t.siv=(6)(&siv[0]) t.rbuf=(6)(&rbuf[0])
?tls_handshake(&t)!=0{\3}
sys(1,1,"TLS established (cert verified)\n",32)
m:[512]1=0 o:=pg_startup(m,"postgres","postgres")
tls_send(&t,m,o)
b:[16384]1=0
n:=tls_recv_msg(&t,b)
?pg_authtype(b)!=10{\4}
cnonce:="ohQrstuvWxyz0123456789AB"
cfb:[128]1=0
cl:=bcopy(cfb,0,"n=,r=")
cl=bcopy(cfb,cl,cnonce)
ir:[160]1=0
il:=bcopy(ir,0,"n,,")
il=bcopy(ir,il,cfb)
mi:[256]1=0
ml:=pg_sasl_init(mi,"SCRAM-SHA-256",ir,il)
tls_send(&t,mi,ml)
n=tls_recv_msg(&t,b)
?pg_authtype(b)!=11{\5}
sf:[512]1=0
sfl:=pg_rpayload(b,sf)
comb:[256]1=0
combl:=field(sf,sfl,114,comb)
sb2:[128]1=0
sbl:=field(sf,sfl,115,sb2)
it:[16]1=0
itl:=field(sf,sfl,105,it)
?combl<0||sbl<0||itl<0{\6}
salt:[64]1=0
saltlen:=b64dec(sb2,sbl,salt)
iter:=atoin(it,itl)
sp:[32]1=0
scram_salted("secret",6,salt,saltlen,iter,sp)
cfwp:[320]1=0
cwl:=bcopy(cfwp,0,"c=biws,r=")
@i,combl{cfwp[cwl+i]=comb[i]}
cwl=cwl+combl
am:[1024]1=0
al:=0
@i,cl{am[al+i]=cfb[i]}
al=al+cl
am[al]=(1)44
al=al+1
@i,sfl{am[al+i]=sf[i]}
al=al+sfl
am[al]=(1)44
al=al+1
@i,cwl{am[al+i]=cfwp[i]}
al=al+cwl
proof:[64]1=0
pl:=scram_proof(sp,am,al,proof)
cf:[420]1=0
c2:=0
@i,cwl{cf[c2+i]=cfwp[i]}
c2=c2+cwl
cf[c2]=(1)44 cf[c2+1]=(1)112 cf[c2+2]=(1)61
c2=c2+3
@i,pl{cf[c2+i]=proof[i]}
c2=c2+pl
mr:[512]1=0
mrl:=pg_sasl_resp(mr,cf,c2)
tls_send(&t,mr,mrl)
n=tls_recv_z(&t,b)
?find_auth(b,(3)n,0)<0{\7}
sys(1,1,"SCRAM authenticated over TLS\n",29)
qb:[256]1=0 qo:=pg_query(qb,"SELECT 'scram-tls-ok'")
tls_send(&t,qb,qo)
n=tls_recv_z(&t,b)
d:=pg_find(b,(3)n,68)
?d<0{\8}
out:[64]1=0 vl:=pg_col0(b,d,out)
sys(1,1,"query -> ",9) sys(1,1,&out[0],vl) sys(1,1,"\n",1)
sys(3,fd)
0}
