// Secure PostgreSQL-over-TLS client: SSLRequest -> TLS 1.3 (std/tls.oh) -> the Postgres
// v3 protocol (std/pg.oh) carried over the encrypted channel. Trust auth (SCRAM-over-TLS
// is a further step). Connects 127.0.0.1:5432. Needs std/core,net,x25519,sha256,sha512,
// hkdf,tls13,aes,gcm,ed25519,tls,pg.
// accumulate Postgres messages over TLS records until a ReadyForQuery is present.
#recv_pg(t:*Tls,buf:c):6{
n:=(6)0
~pg_hasz(buf,(3)n)==0{
chunk:[16384]1=0
r:=tls_recv(t,chunk)
?r<0{\n}
@i,r{buf[n+i]=chunk[i]}
n=n+r
}
n}
#main(){
fd:=connect_to(127,0,0,1,5432)
?fd<0{\1}
// SSLRequest: int32 len=8, int32 80877103 (0x04d2162f)
ssl:[8]1=0
ssl[3]=(1)8 ssl[4]=(1)0x04 ssl[5]=(1)0xd2 ssl[6]=(1)0x16 ssl[7]=(1)0x2f
sys(1,fd,&ssl[0],8)
resp:[1]1=0
sys(0,fd,&resp[0],1)
?(3)resp[0]!=83{sys(1,1,"server refused TLS\n",19) \2}
// TLS handshake over the raw socket
sbx:[256]1=0 crk:[240]1=0 civ:[12]1=0 srk:[240]1=0 siv:[12]1=0 rbuf:[32768]1=0
t:Tls
t.fd=fd
t.sbx=(6)(&sbx[0]) t.crk=(6)(&crk[0]) t.civ=(6)(&civ[0])
t.srk=(6)(&srk[0]) t.siv=(6)(&siv[0]) t.rbuf=(6)(&rbuf[0])
?tls_handshake(&t)!=0{sys(1,1,"TLS HANDSHAKE FAILED\n",21) \3}
sys(1,1,"TLS established to postgres (cert verified)\n",44)
// Postgres startup over TLS
m:[512]1=0 o:=pg_startup(m,"postgres","postgres")
tls_send(&t,m,o)
b:[16384]1=0
n:=recv_pg(&t,b)
?pg_authok(b)!=1{sys(1,1,"auth failed\n",12) \4}
sys(1,1,"postgres authenticated\n",23)
// query over TLS
qb:[256]1=0 qo:=pg_query(qb,"SELECT 'pgtls-ok'")
tls_send(&t,qb,qo)
n=recv_pg(&t,b)
d:=pg_find(b,(3)n,68)
?d<0{sys(1,1,"no row\n",7) \5}
out:[64]1=0 vl:=pg_col0(b,d,out)
sys(1,1,"query over TLS -> ",18) sys(1,1,&out[0],vl) sys(1,1,"\n",1)
sys(3,fd)
0}
