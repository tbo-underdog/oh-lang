// REST client over raw syscalls — connect/send/recv/decode. No libc.
// syscalls: socket=41 connect=42 write=1 read=0 close=3
#slen(s:*1){i:=0 ~s[i]!=0{i=i+1} i}
// copy NUL-terminated src into dst at offset; return new offset
#bcopy(d:*1,off,s:*1){
i:=0
~s[i]!=0{d[off+i]=s[i] i=i+1}
off+i}
// write non-negative int as ascii into d at off; return new offset
#itoa(d:*1,off,n){
?n>=10{off=itoa(d,off,n/10)}
d[off]=(1)(48+n%10)
off+1}
// open TCP connection to a.b.c.e:port, return fd (i64)
#connect_to(a,b,c,e,port):6{
fd:=sys(41,2,1,0)
?fd<0{\-1}
sa:[16]1
sa[0]=2 sa[1]=0
sa[2]=(1)(port/256) sa[3]=(1)(port%256)
sa[4]=(1)a sa[5]=(1)b sa[6]=(1)c sa[7]=(1)e
sa[8]=0 sa[9]=0 sa[10]=0 sa[11]=0 sa[12]=0 sa[13]=0 sa[14]=0 sa[15]=0
?sys(42,fd,&sa,16)<0{\-2}
fd}
// parse 3-digit HTTP status at offset 9 of "HTTP/1.1 NNN ..."
#status(b:*1){
h:=(3)(b[9])-48
t:=(3)(b[10])-48
o:=(3)(b[11])-48
h*100+t*10+o}
// make one request; return decoded HTTP status code
#rest(method:*1,path:*1,body:*1){
fd:=connect_to(127,0,0,1,8090)
?fd<0{\-1}
req:[1024]1
o:=0
o=bcopy(req,o,method)
o=bcopy(req,o," ")
o=bcopy(req,o,path)
o=bcopy(req,o," HTTP/1.1\r\nHost: x\r\nContent-Length: ")
o=itoa(req,o,slen(body))
o=bcopy(req,o,"\r\nConnection: close\r\n\r\n")
o=bcopy(req,o,body)
sys(1,fd,&req,o)
resp:[4096]1
n:=sys(0,fd,&resp,4096)
sys(3,fd)
?n<12{\-3}
status(resp)}
#main(){
?rest("GET","/","")!=200{\1}
?rest("POST","/items","hello")!=200{\2}
?rest("PUT","/items/1","data")!=200{\3}
?rest("DELETE","/items/1","")!=200{\4}
0}
