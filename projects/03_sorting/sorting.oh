#swap(*a,i,j):v{t:=a[i] a[i]=a[j] a[j]=t}
#bsort(*a,n):v{
@i,n-1{@j,n-i-1{?a[j]>a[j+1]{swap(a,j,j+1)}}}}
#isort(*a,n):v{
@i=1,n{
key:=a[i]
j:=i-1
~j>=0&&a[j]>key{t:=j+1 a[t]=a[j] j=j-1}
t2:=j+1
a[t2]=key}}
#ssort(*a,n):v{
@i,n-1{
mi:=i
@j=i+1,n{?a[j]<a[mi]{mi=j}}
swap(a,i,mi)}}
#issorted(*a,n){
@i,n-1{?a[i]>a[i+1]{\0}}
1}
#main(){
a:[10]3=[5,3,8,1,9,2,7,4,6,0]
b:[10]3=[5,3,8,1,9,2,7,4,6,0]
c:[10]3=[5,3,8,1,9,2,7,4,6,0]
bsort(a,10) isort(b,10) ssort(c,10)
?issorted(a,10)==0{\1}
?issorted(b,10)==0{\2}
?issorted(c,10)==0{\3}
?a[0]!=0{\4}
?a[9]!=9{\5}
0}
