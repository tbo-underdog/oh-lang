// Minimal MongoDB client in Oh — insert a doc, then find it back. OP_MSG wire
// protocol + BSON, raw sockets, no libc. Connects to 127.0.0.1:27017.
// Needs std/core, std/net (connect_to), std/bson.
#send_msg(fd:6,m:c,w):v{
w32(m,0,w)
w32(m,4,1)
w32(m,8,0)
w32(m,12,2013)
w32(m,16,0)
m[20]=0
sys(1,fd,&m[0],w)}
#main(){
fd:=connect_to(127,0,0,1,27017)
?fd<0{\1}
m:[1024]1=0
rep:[4096]1=0
w:=bson_begin(m,21)
w=bson_str(m,w,"insert","users",5)
w=bson_elem(m,w,4,"documents")
arr:=w
w=bson_begin(m,arr)
w=bson_elem(m,w,3,"0")
sub:=w
w=bson_begin(m,sub)
w=bson_str(m,w,"name","alice",5)
w=bson_end(m,sub,w)
w=bson_end(m,arr,w)
w=bson_str(m,w,"$db","ohtest",6)
w=bson_end(m,21,w)
send_msg(fd,m,w)
sys(0,fd,&rep[0],4096)
?bson_find(rep,21,"ok")<0{\2}
w=bson_begin(m,21)
w=bson_str(m,w,"find","users",5)
w=bson_elem(m,w,3,"filter")
flt:=w
w=bson_begin(m,flt)
w=bson_str(m,w,"name","alice",5)
w=bson_end(m,flt,w)
w=bson_str(m,w,"$db","ohtest",6)
w=bson_end(m,21,w)
send_msg(fd,m,w)
sys(0,fd,&rep[0],4096)
co:=bson_find(rep,21,"cursor")
fb:=bson_find(rep,co,"firstBatch")
d0:=bson_find(rep,fb,"0")
nm:=bson_find(rep,d0,"name")
?nm<0{\3}
name:[32]1=0
nl:=bson_getstr(rep,nm,name)
sys(1,1,&name[0],nl)
sys(1,1,"\n",1)
sys(3,fd)
0}
