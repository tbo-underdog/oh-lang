// PostgreSQL client with SCRAM-SHA-256 auth — talks to a password-protected server.
// Full SASL handshake: startup -> AuthenticationSASL -> client-first -> server-first
// -> client-final (ClientProof) -> SASLFinal (verify ServerSignature) -> query.
// Needs std/core, std/net, std/pg, std/sha256, std/b64, std/scram.
#recv_msg(fd:6,b:c){
n:=0
~n<5{
r:=sys(0,fd,&b[n],8192-n)
?r<=0{\n}
n=n+(3)r}
~1+be32r(b,1)>n{
r:=sys(0,fd,&b[n],8192-n)
?r<=0{\n}
n=n+(3)r}
n}
#recv_z(fd:6,b:c){
n:=0
~pg_hasz(b,n)==0{
r:=sys(0,fd,&b[n],8192-n)
?r<=0{\n}
n=n+(3)r}
n}
// find SASL field value by key char ('r'/'s'/'i'); value runs to next ',' or end.
#field(msg:c,n,key,out:c){
i:=0
~i<n{
?(i==0||(3)msg[i-1]==44)&&(3)msg[i]==key&&(3)msg[i+1]==61{
j:=i+2
o:=0
~j<n&&(3)msg[j]!=44{
out[o]=msg[j]
o=o+1
j=j+1}
\o}
i=i+1}
0-1}
#atoin(s:c,n){
v:=0
@i,n{v=v*10+((3)s[i]-48)}
v}
// find first 'R'(82) message with the given subtype; return its offset or -1
#find_auth(b:c,n,sub){
o:=0
~o+9<=n{
?(3)b[o]==82&&be32r(b,o+5)==sub{\o}
len:=be32r(b,o+1)
?len<=0{\0-1}
o=o+1+len}
0-1}
#main(){
fd:=connect_to(127,0,0,1,5432)
?fd<0{\1}
b:[8192]1=0
o:=pg_startup(b,"postgres","postgres")
sys(1,fd,&b[0],o)
recv_msg(fd,b)
at:=pg_authtype(b)
?at==0{
sys(1,1,"server used trust, not scram\n",29)
\90}
?at!=10{\2}
cnonce:="ohQrstuvWxyz0123456789AB"
cfb:[128]1=0
cl:=bcopy(cfb,0,"n=,r=")
cl=bcopy(cfb,cl,cnonce)
ir:[160]1=0
il:=bcopy(ir,0,"n,,")
il=bcopy(ir,il,cfb)
m:[256]1=0
ml:=pg_sasl_init(m,"SCRAM-SHA-256",ir,il)
sys(1,fd,&m[0],ml)
recv_msg(fd,b)
?pg_authtype(b)!=11{\3}
sf:[512]1=0
sfl:=pg_rpayload(b,sf)
comb:[256]1=0
combl:=field(sf,sfl,114,comb)
sb:[128]1=0
sbl:=field(sf,sfl,115,sb)
it:[16]1=0
itl:=field(sf,sfl,105,it)
?combl<0||sbl<0||itl<0{\4}
salt:[64]1=0
saltlen:=b64dec(sb,sbl,salt)
iter:=atoin(it,itl)
sp:[32]1=0
scram_salted("secret",6,salt,saltlen,iter,sp)
cfwp:[320]1=0
cwl:=bcopy(cfwp,0,"c=biws,r=")
@i,combl{cfwp[cwl+i]=comb[i]}
cwl=cwl+combl
am:[1024]1=0
al:=0
@i,cl{am[al+i]=cfb[i]}
al=al+cl
am[al]=(1)44
al=al+1
@i,sfl{am[al+i]=sf[i]}
al=al+sfl
am[al]=(1)44
al=al+1
@i,cwl{am[al+i]=cfwp[i]}
al=al+cwl
proof:[64]1=0
pl:=scram_proof(sp,am,al,proof)
cf:[420]1=0
c2:=0
@i,cwl{cf[c2+i]=cfwp[i]}
c2=c2+cwl
cf[c2]=(1)44
cf[c2+1]=(1)112
cf[c2+2]=(1)61
c2=c2+3
@i,pl{cf[c2+i]=proof[i]}
c2=c2+pl
mm:[512]1=0
mml:=pg_sasl_resp(mm,cf,c2)
sys(1,fd,&mm[0],mml)
n:=recv_z(fd,b)
rf:=find_auth(b,n,12)
?rf<0{\5}
vp:[128]1=0
vpl:=pg_rpayload(&b[rf],vp)
mysig:[64]1=0
ssl:=scram_serversig(sp,am,al,mysig)
?memcmp(&vp[2],mysig,ssl)!=0{
sys(1,1,"server signature mismatch\n",26)
\6}
?find_auth(b,n,0)<0{\7}
qb:[256]1=0
qo:=pg_query(qb,"SELECT 'scram-ok'")
sys(1,fd,&qb[0],qo)
n=recv_z(fd,b)
d:=pg_find(b,n,68)
?d<0{\8}
out:[64]1=0
vl:=pg_col0(b,d,out)
sys(1,1,&out[0],vl)
sys(1,1,"\n",1)
sys(3,fd)
0}
