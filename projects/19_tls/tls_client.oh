// TLS 1.3 client (milestone 1: ClientHello + read ServerHello). x25519 + AES-128-GCM
// + SHA256. Needs std/core, std/net, std/x25519, std/sha256, std/hkdf, std/tls13,
// std/aes, std/gcm. Connects 127.0.0.1:4433.
#w16(b:c,o,v):v{b[o]=(1)((v>>8)&255) b[o+1]=(1)(v&255)}
#main(){
fd:=connect_to(127,0,0,1,4433)
?fd<0{\1}
// x25519 keypair
priv:[32]1=0
rand_bytes(priv,32)
basep:[32]1=0 basep[0]=(1)9
pub:[32]1=0
x25519(pub,priv,basep)
// ---- build ClientHello handshake message body into hb ----
hb:[512]1=0
o:=0
hb[o]=(1)3 hb[o+1]=(1)3 o=o+2                 // legacy_version 0x0303
crand:[32]1=0 rand_bytes(crand,32)
@i,32{hb[o+i]=crand[i]} o=o+32                 // random
hb[o]=(1)32 o=o+1                               // session_id len
sid:[32]1=0 rand_bytes(sid,32)
@i,32{hb[o+i]=sid[i]} o=o+32                     // session_id
w16(hb,o,2) o=o+2 hb[o]=(1)0x13 hb[o+1]=(1)0x01 o=o+2  // cipher_suites: TLS_AES_128_GCM_SHA256
hb[o]=(1)1 o=o+1 hb[o]=(1)0 o=o+1               // compression: null
// extensions
extlenpos:=o o=o+2
// supported_versions (0x002b)
w16(hb,o,0x2b) o=o+2 w16(hb,o,3) o=o+2 hb[o]=(1)2 o=o+1 w16(hb,o,0x0304) o=o+2
// supported_groups (0x000a) -> x25519 (0x001d)
w16(hb,o,0x0a) o=o+2 w16(hb,o,4) o=o+2 w16(hb,o,2) o=o+2 w16(hb,o,0x1d) o=o+2
// signature_algorithms (0x000d) -> ed25519(0x0807), ecdsa_p256(0x0403), rsa_pss(0x0804)
w16(hb,o,0x0d) o=o+2 w16(hb,o,8) o=o+2 w16(hb,o,6) o=o+2
w16(hb,o,0x0807) o=o+2 w16(hb,o,0x0403) o=o+2 w16(hb,o,0x0804) o=o+2
// key_share (0x0033)
w16(hb,o,0x33) o=o+2 w16(hb,o,38) o=o+2 w16(hb,o,36) o=o+2 w16(hb,o,0x1d) o=o+2 w16(hb,o,32) o=o+2
@i,32{hb[o+i]=pub[i]} o=o+32
// backpatch extensions length
w16(hb,extlenpos,o-extlenpos-2)
bodylen:=o
// ---- wrap as handshake message: type(1)=ClientHello + len(3) + body ----
msg:[600]1=0
msg[0]=(1)1
msg[1]=(1)0 msg[2]=(1)((bodylen>>8)&255) msg[3]=(1)(bodylen&255)
@i,bodylen{msg[4+i]=hb[i]}
msglen:=4+bodylen
// ---- wrap in TLS record: type 22, version 0x0301, length ----
rec:[700]1=0
rec[0]=(1)22 rec[1]=(1)3 rec[2]=(1)1
w16(rec,3,msglen)
@i,msglen{rec[5+i]=msg[i]}
sys(1,fd,&rec[0],5+msglen)
// read response, dump type + length of first record
resp:[4096]1=0
n:=sys(0,fd,&resp[0],4096)
?n<=0{\2}
// print: first record type byte and total bytes read, as two lines of hex
hd:="0123456789abcdef"
sys(1,1,&hd[((3)resp[0]>>4)&15],1) sys(1,1,&hd[(3)resp[0]&15],1)
sys(1,1,"\n",1)
sys(3,fd)
0}
