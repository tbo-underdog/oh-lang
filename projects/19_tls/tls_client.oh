// TLS 1.3 client. Milestone 2: ClientHello -> ServerHello -> key schedule -> decrypt
// the server's first encrypted handshake record (EncryptedExtensions). x25519 +
// AES-128-GCM + SHA256. Connects 127.0.0.1:4433.
#w16(b:c,o,v):v{b[o]=(1)((v>>8)&255) b[o+1]=(1)(v&255)}
#r16(b:c,o:6):6{(((3)b[o]&255)<<8)|((3)b[o+1]&255)}
// ensure the record buffer holds at least `need` bytes (st[0]=bufn)
#rd_fill(fd:6,buf:c,st:*6,need:6):v{
~st[0]<need{
r:=sys(0,fd,&buf[st[0]],16384-st[0])
?r<=0{\}
st[0]=st[0]+r
}}
#main(){
fd:=connect_to(127,0,0,1,4433)
?fd<0{\1}
priv:[32]1=0 rand_bytes(priv,32)
basep:[32]1=0 basep[0]=(1)9
pub:[32]1=0 x25519(pub,priv,basep)
// ClientHello body
hb:[512]1=0
o:=0
hb[o]=(1)3 hb[o+1]=(1)3 o=o+2
crand:[32]1=0 rand_bytes(crand,32)
@i,32{hb[o+i]=crand[i]} o=o+32
hb[o]=(1)32 o=o+1
sid:[32]1=0 rand_bytes(sid,32)
@i,32{hb[o+i]=sid[i]} o=o+32
w16(hb,o,2) o=o+2 hb[o]=(1)0x13 hb[o+1]=(1)0x01 o=o+2
hb[o]=(1)1 o=o+1 hb[o]=(1)0 o=o+1
extlenpos:=o o=o+2
w16(hb,o,0x2b) o=o+2 w16(hb,o,3) o=o+2 hb[o]=(1)2 o=o+1 w16(hb,o,0x0304) o=o+2
w16(hb,o,0x0a) o=o+2 w16(hb,o,4) o=o+2 w16(hb,o,2) o=o+2 w16(hb,o,0x1d) o=o+2
w16(hb,o,0x0d) o=o+2 w16(hb,o,8) o=o+2 w16(hb,o,6) o=o+2
w16(hb,o,0x0807) o=o+2 w16(hb,o,0x0403) o=o+2 w16(hb,o,0x0804) o=o+2
w16(hb,o,0x33) o=o+2 w16(hb,o,38) o=o+2 w16(hb,o,36) o=o+2 w16(hb,o,0x1d) o=o+2 w16(hb,o,32) o=o+2
@i,32{hb[o+i]=pub[i]} o=o+32
w16(hb,extlenpos,o-extlenpos-2)
bodylen:=o
// transcript buffer: append ClientHello handshake message
tr:[8192]1=0
trlen:=(6)0
tr[0]=(1)1 tr[1]=(1)0 tr[2]=(1)((bodylen>>8)&255) tr[3]=(1)(bodylen&255)
@i,bodylen{tr[4+i]=hb[i]}
trlen=(6)(4+bodylen)
// send as record
rec:[700]1=0
rec[0]=(1)22 rec[1]=(1)3 rec[2]=(1)1 w16(rec,3,(3)trlen)
@i,trlen{rec[5+i]=tr[i]}
sys(1,fd,&rec[0],5+trlen)
// ---- read records ----
buf:[16384]1=0
st:[2]6=0
pos:=(6)0
// record 1: ServerHello (plaintext, type 22)
rd_fill(fd,buf,st,pos+5)
?((3)buf[pos]&255)!=22{\2}
shlen:=r16(buf,pos+3)
rd_fill(fd,buf,st,pos+5+shlen)
shoff:=pos+5
// append ServerHello handshake message to transcript
@i,shlen{tr[trlen+i]=buf[shoff+i]}
trlen=trlen+shlen
// parse ServerHello to find server key_share (group 0x001d)
// handshake: type(1)=2,len(3),body: ver(2),random(32),sidlen(1)+sid,cipher(2),comp(1),extlen(2),exts
p:=shoff+4
p=p+2+32
slen:=(6)((3)buf[p]&255) p=p+1+slen
p=p+2+1
extslen:=r16(buf,p) p=p+2
exend:=p+extslen
spub:[32]1=0
found:=0
~p<exend{
et:=r16(buf,p)
el:=r16(buf,p+2)
?et==0x33{
// key_share: group(2),keylen(2),key
@i,32{spub[i]=buf[p+4+4+i]}
found=1
}
p=p+4+el
}
?found==0{\3}
// shared secret
shared:[32]1=0 x25519(shared,priv,spub)
// transcript hash (CH||SH)
thash:[32]1=0 sha256(tr,(3)trlen,thash)
// key schedule
hs:[32]1=0 cs:[32]1=0 ss:[32]1=0
tls_handshake_secrets(shared,thash,hs,cs,ss)
skey:[16]1=0 siv:[12]1=0
tls_traffic_keyiv(ss,skey,siv)
sb:[256]1=0 aes_sbox(sb)
rk:[240]1=0 nr:=aes_expand(skey,16,sb,rk)
pos=pos+5+shlen
// skip records until first encrypted application_data (type 23); skip CCS (type 20)
seq:=0
~1{
rd_fill(fd,buf,st,pos+5)
rt:=(3)buf[pos]&255
rl:=r16(buf,pos+3)
rd_fill(fd,buf,st,pos+5+rl)
?rt==23{
// decrypt: nonce = siv ^ seq(8B BE in low bytes); aad = 5-byte header
nonce:[12]1=0 @i,12{nonce[i]=siv[i]}
// seq=0 for first -> nonce=siv; (general XOR omitted, seq fits in low byte here)
aad:[5]1=0 @i,5{aad[i]=buf[pos+i]}
ctlen:=rl-16
ct:[16384]1=0 @i,ctlen{ct[i]=buf[pos+5+i]}
tag:[16]1=0 @i,16{tag[i]=buf[pos+5+ctlen+i]}
ptn:[16384]1=0
ok:=aes_gcm_decrypt(rk,nr,sb,nonce,aad,5,ct,(3)ctlen,tag,ptn)
?ok!=1{sys(1,1,"DECRYPT FAIL\n",13) \4}
// inner: content || real_type || zeros. first byte should be 0x08 (EncryptedExtensions)
hd:="0123456789abcdef"
sys(1,1,"decrypted inner first byte=0x",29)
sys(1,1,&hd[((3)ptn[0]>>4)&15],1) sys(1,1,&hd[(3)ptn[0]&15],1)
sys(1,1,"\n",1)
sys(3,fd)
\0
}
pos=pos+5+rl
}
0}
