// Echo server as a PLAIN BLOCKING coroutine handler — compare to echo.oh's hand
// state machine. The scheduler (std/co.oh) makes the blocking style non-blocking.
#conn_handler(c:*Conn):v{
buf:[4096]1=0
~1{
n:=co_read(c,&buf[0],4096)
?n<=0{co_close(c)}
co_write(c,&buf[0],n)
}}
#main(){
hp:[3]6=0
heap_new(&hp[0],16777216)
s:Sched
?co_init(&s,(6)(&hp[0]),(6)(&conn_handler),7000,128)<0{\1}
co_run(&s)
0}
